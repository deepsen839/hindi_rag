"""Run all six mandatory queries and save generated answers + automatic citations."""
import json, time
from pathlib import Path
from rag.retriever import HindiRetriever
from rag.generator import HindiGroundedGenerator, select_citations
ROOT=Path(__file__).resolve().parents[1]
questions=json.loads((ROOT/'evaluation/assignment_queries.json').read_text(encoding='utf-8'))
retriever=HindiRetriever(); generator=HindiGroundedGenerator(); records=[]
for q in questions:
    t=time.perf_counter(); hits=retriever.search(q['question'],top_k=5,hybrid=True)
    retrieval_ms=(time.perf_counter()-t)*1000
    t=time.perf_counter(); answer=generator.answer(q['question'],hits)
    generation_ms=(time.perf_counter()-t)*1000
    citations=select_citations(q['question'],answer,hits)
    record={'id':q['id'],'question':q['question'],'answer_hi':answer,
            'retrieval_ms':round(retrieval_ms,2),'generation_ms':round(generation_ms,2),
            'citations':citations,
            'retrieved':[{'page':h['page'],'section':h.get('section','दस्तावेज़'),
                          'chunk_id':h['chunk_id'],'score':round(float(h['score']),5),
                          'source_type':h.get('source_type','paragraph'),'text':h['text']} for h in hits]}
    records.append(record)
    print(f"\n[{q['id']}] {q['question']}\n{answer}\nCitations: {citations}\n",flush=True)
(ROOT/'reports').mkdir(exist_ok=True)
(ROOT/'reports/assignment_answers.json').write_text(json.dumps(records,ensure_ascii=False,indent=2),encoding='utf-8')
lines=['# MegaMindz — six mandatory assignment queries','',
       'Generated by `python -m evaluation.run_assignment_queries` using the local retrieval index and configured Qwen model.','']
for r in records:
    lines += [f"## {r['id']}. {r['question']}",'',f"**उत्तर:** {r['answer_hi']}",'', '**स्रोत:**']
    for c in r['citations']:
        lines.append(f"- PDF पृष्ठ {c['page']} · अनुभाग: {c['section']} · chunk_id: `{c['chunk_id']}` · score: {c['score']}")
    lines.append('')
(ROOT/'reports/assignment_answers.md').write_text('\n'.join(lines),encoding='utf-8')
print(f"Saved {len(records)} generated answers and citations under reports/.")
